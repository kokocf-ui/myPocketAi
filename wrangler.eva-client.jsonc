{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "eva-site-client",
  "main": "./studio_worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "vars": {
    "STUDIO_AI_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      { "name": "STUDIO_ACCOUNTS", "class_name": "StudioAccounts" },
      { "name": "STUDIO_SITES", "class_name": "StudioSites" }
    ]
  },
  "exports": {
    "StudioAccounts": { "type": "durable-object", "storage": "sqlite" },
    "StudioSites": { "type": "durable-object", "storage": "sqlite" }
  }
}
