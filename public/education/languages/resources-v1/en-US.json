  "lessons": [
    {
      "id": "grammar-0",
      "title": "be",
      "explanation": "Prezent simplu. Folosește am cu I, is cu he/she/it și are cu you/we/they. Pentru negație adaugă not; la întrebare inversează verbul și subiectul: Are you ready?",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "I",
          "form": "am"
        },
        {
          "person": "you",
          "form": "are"
        },
        {
          "person": "he / she / it",
          "form": "is"
        },
        {
          "person": "we",
          "form": "are"
        },
        {
          "person": "you (plural)",
          "form": "are"
        },
        {
          "person": "they",
          "form": "are"
        }
      ],
      "task": {
        "prompt": "She ___ a student.",
        "answers": [
          "is"
        ],
        "feedback": "Compară persoana, timpul și forma din tabel. Păstrează accentele și diacriticele."
      }
    },
    {
      "id": "grammar-1",
      "title": "learn",
      "explanation": "Prezent simplu afirmativ: persoana a III-a singular adaugă -s. După does/does not revii la learn, nu learns.",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "I",
          "form": "learn"
        },
        {
          "person": "you",
          "form": "learn"
        },
        {
          "person": "he / she / it",
          "form": "learns"
        },
        {
          "person": "we",
          "form": "learn"
        },
        {
          "person": "you (plural)",
          "form": "learn"
        },
        {
          "person": "they",
          "form": "learn"
        }
      ],
      "task": {
        "prompt": "He ___ English.",
        "answers": [
          "learns"
        ],
        "feedback": "Compară persoana, timpul și forma din tabel. Păstrează accentele și diacriticele."
      }
    },
    {
      "id": "grammar-2",
      "title": "have — present",
      "explanation": "Have exprimă posesia. Folosește has la he/she/it, have la celelalte persoane. În întrebările cu does folosește have, nu has. Greșeală frecventă: Does she has? în loc de Does she have?",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "I / you / we / they",
          "form": "have"
        },
        {
          "person": "he / she / it",
          "form": "has"
        },
        {
          "person": "question",
          "form": "Does she have a book?"
        },
        {
          "person": "negative",
          "form": "She does not have a book."
        }
      ],
      "task": {
        "prompt": "He ___ a book.",
        "answers": [
          "has"
        ],
        "feedback": "He este persoana a III-a singular: has."
      }
    },
    {
      "id": "grammar-3",
      "title": "do / does — questions",
      "explanation": "La prezent simplu, o întrebare folosește do sau does + subiect + verb de bază. Does preia marca persoanei a III-a; nu mai pune -s la verb. Verbul be nu folosește do în acest model.",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "I / you / we / they",
          "form": "Do you learn English?"
        },
        {
          "person": "he / she / it",
          "form": "Does he learn English?"
        },
        {
          "person": "short answer",
          "form": "Yes, he does."
        },
        {
          "person": "short negative answer",
          "form": "No, he does not."
        }
      ],
      "task": {
        "prompt": "___ she learn English?",
        "answers": [
          "Does",
          "does"
        ],
        "feedback": "She cere does, iar learn rămâne forma de bază."
      }
    },
    {
      "id": "grammar-4",
      "title": "do not / does not — negatives",
      "explanation": "Negația prezentului simplu: do not / does not + verb de bază. Formele scurte sunt don’t și doesn’t. Greșeală: She doesn’t learns. Corect: She doesn’t learn.",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "I / you / we / they",
          "form": "do not learn"
        },
        {
          "person": "he / she / it",
          "form": "does not learn"
        },
        {
          "person": "contraction",
          "form": "does not = doesn’t"
        }
      ],
      "task": {
        "prompt": "She does not ___ English.",
        "answers": [
          "learn"
        ],
        "feedback": "După does not folosește learn fără -s."
      }
    },
    {
      "id": "grammar-5",
      "title": "be — past",
      "explanation": "Trecutul lui be este was cu I/he/she/it și were cu you/we/they. Negația adaugă not; întrebarea inversează subiectul și verbul. Nu adăuga did înaintea lui was/were.",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "I / he / she / it",
          "form": "was"
        },
        {
          "person": "you / we / they",
          "form": "were"
        },
        {
          "person": "question",
          "form": "Were they at home?"
        },
        {
          "person": "negative",
          "form": "They were not at home."
        }
      ],
      "task": {
        "prompt": "They ___ at home yesterday.",
        "answers": [
          "were"
        ],
        "feedback": "They se combină cu were."
      }
    },
    {
      "id": "grammar-6",
      "title": "learn — past simple",
      "explanation": "Verbele regulate primesc de obicei -ed în trecut. Learn are learned și, mai ales în engleza britanică, learnt. După did / did not revii la learn. Nu spune Did she learned?",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "affirmative",
          "form": "She learned English."
        },
        {
          "person": "negative",
          "form": "She did not learn English."
        },
        {
          "person": "question",
          "form": "Did she learn English?"
        }
      ],
      "task": {
        "prompt": "Did he ___ English?",
        "answers": [
          "learn"
        ],
        "feedback": "Did marchează trecutul; learn rămâne forma de bază."
      }
    },
    {
      "id": "grammar-7",
      "title": "be + -ing — present continuous",
      "explanation": "Pentru o acțiune în desfășurare folosește am/is/are + verb cu -ing. Nu omite be: She learning este incomplet. Compară rutina She learns every day cu acțiunea She is learning now.",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "I",
          "form": "am learning"
        },
        {
          "person": "he / she / it",
          "form": "is learning"
        },
        {
          "person": "you / we / they",
          "form": "are learning"
        },
        {
          "person": "question",
          "form": "Are you learning?"
        }
      ],
      "task": {
        "prompt": "She ___ learning now.",
        "answers": [
          "is"
        ],
        "feedback": "She cere is; learning este deja în enunț."
      }
    },
    {
      "id": "grammar-8",
      "title": "can — ability and requests",
      "explanation": "Can exprimă capacitatea sau o cerere. După can urmează verbul de bază fără to. Nu adăuga -s: She can swim, nu She cans swims. Întrebarea începe cu Can.",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "affirmative",
          "form": "She can swim."
        },
        {
          "person": "negative",
          "form": "She cannot swim."
        },
        {
          "person": "question",
          "form": "Can she swim?"
        },
        {
          "person": "request",
          "form": "Can you help me?"
        }
      ],
      "task": {
        "prompt": "She can ___ . (swim / swims)",
        "answers": [
          "swim"
        ],
        "feedback": "După can se folosește swim, fără -s și fără to."
      }
    },
    {
      "id": "grammar-9",
      "title": "a / an / the — articles",
      "explanation": "A/an introduc un substantiv singular numărabil nespecific. Alegerea se face după sunet: a book, an apple, an hour. The identifică un lucru deja cunoscut. Nu spune a water când te referi la apă ca substanță.",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "consonant sound",
          "form": "a book"
        },
        {
          "person": "vowel sound",
          "form": "an apple"
        },
        {
          "person": "silent h",
          "form": "an hour"
        },
        {
          "person": "known object",
          "form": "the book on the table"
        }
      ],
      "task": {
        "prompt": "I have ___ apple.",
        "answers": [
          "an"
        ],
        "feedback": "Apple începe cu sunet vocalic: an apple."
      }
    },
    {
      "id": "grammar-10",
      "title": "there is / there are",
      "explanation": "There is introduce un lucru singular sau nenumărabil; there are introduce pluralul. Nu confunda there cu their (lor). La întrebare inversează: Is there...? / Are there...?",
      "sourceLanguage": "ro",
      "forms": [
        {
          "person": "singular",
          "form": "There is a book."
        },
        {
          "person": "plural",
          "form": "There are two books."
