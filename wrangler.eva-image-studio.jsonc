{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifewise-ai-image-studio",
  "main": "./eva_image_studio_worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "DAILY_IMAGE_LIMIT": "3",
    "PER_INSTALL_DAILY_LIMIT": "3",
    "PREVIEW_GLOBAL_DAILY_MAX": "300"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IMAGE_QUOTA",
        "class_name": "ImageQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "eva-image-studio-v1",
      "new_sqlite_classes": [
        "ImageQuota"
      ]
    }
  ]
}
